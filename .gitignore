# ============================================================================
#  CyberGuard —— Git 忽略规则
# ============================================================================
#  原则：只提交「运行本作品所必需」的源码与文档。
#        构建产物、依赖目录、IDE 配置、与作品无关的工具链一律排除。
# ============================================================================

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境（体积大且与平台相关，用 requirements.txt 重建）
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------- 运行时数据
# db.sqlite3 是**刻意提交**的演示数据：克隆后启动即可看到填充好的界面。
# 仅忽略 SQLite 运行期产生的临时文件与手工备份。
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
db.backup-*.sqlite3

# ---------------------------------------------------------------- IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- 与作品无关的工具链
# frontend/ 是一套独立的 ppt-frontend 幻灯片构建工具（Vite + Tailwind），
# 与本作品（DDoS 防护监控平台）无关，且 node_modules 达 40MB，故不纳入仓库。
frontend/
.workbuddy/
.cloudstudio
docs/project.json

# ---------------------------------------------------------------- 临时文件
*.tmp
*.log
*.bak
*.orig
*.rej
_probe.txt
